{
  "info": {
    "name": "FitPro Gym Management API",
    "description": "Complete Postman collection for manual testing of all endpoints.",
    "_postman_id": "fitpro-gym-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8080" },
    { "key": "admin_token",   "value": "" },
    { "key": "member_token",  "value": "" },
    { "key": "trainer_token", "value": "" },
    { "key": "member_email",  "value": "testmember@gmail.com" },
    { "key": "member_id",     "value": "" },
    { "key": "plan_id",       "value": "" },
    { "key": "order_id",      "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Member",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var j = pm.response.json();",
            "pm.test('Token present', () => pm.expect(j.token).to.be.a('string'));",
            "pm.collectionVariables.set('member_token', j.token);",
            "pm.collectionVariables.set('member_id', j.userId);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Member\",\n  \"email\": \"{{member_email}}\",\n  \"password\": \"password123\",\n  \"role\": \"MEMBER\",\n  \"phone\": \"9876543210\"\n}" }
          }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var j = pm.response.json();",
            "pm.test('Role is ADMIN', () => pm.expect(j.role).to.eql('ADMIN'));",
            "pm.collectionVariables.set('admin_token', j.token);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"123456\"\n}" }
          }
        },
        {
          "name": "Login Member",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('member_token', pm.response.json().token);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login Wrong Password (expect 401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));",
            "pm.test('Error field present', () => pm.expect(pm.response.json().error).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"wrongpassword\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Forgot Password Flow",
      "item": [
        {
          "name": "Step 1 - Forgot Password (sends OTP email)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Message present', () => pm.expect(pm.response.json().message).to.include('OTP'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/users/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\"\n}" }
          }
        },
        {
          "name": "Step 2 - Verify OTP (wrong — expect 400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "pm.test('verified is false', () => pm.expect(pm.response.json().verified).to.eql(false));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/users/verify-otp",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"otp\": \"000000\"\n}" }
          }
        },
        {
          "name": "Step 2 - Verify OTP (correct — paste real OTP from email)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('verified is true', () => pm.expect(pm.response.json().verified).to.eql(true));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/users/verify-otp",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"otp\": \"PASTE_OTP_HERE\"\n}" }
          }
        },
        {
          "name": "Step 3 - Reset Password",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Success message', () => pm.expect(pm.response.json().message).to.include('reset'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/users/reset-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"otp\": \"PASTE_OTP_HERE\",\n  \"newPassword\": \"newpass123\"\n}" }
          }
        },
        {
          "name": "Step 4 - Login with new password",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Token returned', () => pm.expect(pm.response.json().token).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"newpass123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "3. Membership Plans",
      "item": [
        {
          "name": "GET All Plans (public auth)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Array returned', () => pm.expect(pm.response.json()).to.be.an('array'));",
            "if (pm.response.json().length > 0) pm.collectionVariables.set('plan_id', pm.response.json()[0].id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{member_token}}" }],
            "url": "{{base_url}}/api/plans"
          }
        },
        {
          "name": "GET Active Plans",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('All active', () => pm.response.json().forEach(p => pm.expect(p.active).to.eql(true)));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{member_token}}" }],
            "url": "{{base_url}}/api/plans/active"
          }
        },
        {
          "name": "POST Create Plan (Admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('plan_id', pm.response.json().id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/plans",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Plan\",\n  \"description\": \"A test plan\",\n  \"price\": 199.00,\n  \"durationMonths\": 1,\n  \"features\": \"Gym Access,Locker\",\n  \"active\": true\n}" }
          }
        },
        {
          "name": "POST Create Plan (Member — expect 403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 403', () => pm.response.to.have.status(403));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{member_token}}" }],
            "url": "{{base_url}}/api/plans",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hack Plan\",\n  \"price\": 1.00,\n  \"durationMonths\": 12\n}" }
          }
        },
        {
          "name": "PUT Update Plan (Admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/plans/{{plan_id}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Plan Updated\",\n  \"price\": 249.00,\n  \"durationMonths\": 1,\n  \"active\": true\n}" }
          }
        },
        {
          "name": "DELETE Plan (Admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/plans/{{plan_id}}"
          }
        }
      ]
    },
    {
      "name": "4. Cashfree Payment Flow",
      "item": [
        {
          "name": "Step 1 - Create Cashfree Order (Member)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var j = pm.response.json();",
            "pm.test('order_id present', () => pm.expect(j.order_id).to.be.a('string'));",
            "pm.test('payment_session_id present', () => pm.expect(j.payment_session_id).to.be.a('string'));",
            "pm.collectionVariables.set('order_id', j.order_id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{member_token}}" }],
            "url": "{{base_url}}/cashfree/order",
            "body": { "mode": "raw", "raw": "{\n  \"planId\": 1\n}" }
          }
        },
        {
          "name": "Step 2 - Simulate Webhook Callback (PAID)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-signature", "value": "SANDBOX_BYPASS_FOR_TESTING" },
              { "key": "x-webhook-timestamp", "value": "1700000000" }
            ],
            "url": "{{base_url}}/cashfree/callback",
            "body": { "mode": "raw", "raw": "{\n  \"data\": {\n    \"order\": {\n      \"order_id\": \"{{order_id}}\",\n      \"order_status\": \"PAID\"\n    }\n  }\n}" }
          }
        },
        {
          "name": "Step 3 - Verify Payment Status",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 or 400', () => pm.expect([200,400]).to.include(pm.response.code));",
            "pm.test('order_status present', () => pm.expect(pm.response.json().order_status).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{member_token}}" }],
            "url": "{{base_url}}/cashfree/verify/{{order_id}}"
          }
        }
      ]
    },
