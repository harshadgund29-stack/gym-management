    {
      "name": "10. Error Handling Checks",
      "item": [
        {
          "name": "GET Unknown Route (expect 404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));",
            "pm.test('JSON error body', () => pm.expect(pm.response.json().status).to.eql(404));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/nonexistent-route"
          }
        },
        {
          "name": "POST Register with invalid email (expect 400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "pm.test('fieldErrors present', () => pm.expect(pm.response.json().fieldErrors).to.be.an('object'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\",\n  \"role\": \"MEMBER\"\n}" }
          }
        },
        {
          "name": "GET Plan by non-existent ID (expect 404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));",
            "pm.test('message present', () => pm.expect(pm.response.json().message).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/plans/99999"
          }
        },
        {
          "name": "GET Protected Route without token (expect 403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 403', () => pm.response.to.have.status(403));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/dashboard/stats"
          }
        }
      ]
    }
  ]
}
